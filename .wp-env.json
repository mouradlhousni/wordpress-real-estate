{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "plugins": [ "./plugins/keystone-properties" ],
  "themes": [ "./themes/keystone" ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": false,
    "KEYSTONE_DEMO_MODE": true,
    "KEYSTONE_STATIC_BUILD": false
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp theme activate keystone && npx wp-env run cli wp rewrite structure /%postname%/ --hard"
  }
}
