{
  "name": "keystone-realty",
  "version": "1.0.0",
  "private": true,
  "description": "Keystone Realty – custom WordPress theme and plugin (portfolio project).",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:blocks && npm run build:assets",
    "start": "wp-scripts start --webpack-src-dir=themes/keystone/src/blocks --output-path=themes/keystone/build/blocks --webpack-copy-php",
    "lint:js": "wp-scripts lint-js themes/keystone/src themes/keystone/assets/js plugins/keystone-properties/assets/js",
    "lint:css": "wp-scripts lint-style \"themes/keystone/assets/css/**/*.css\"",
    "lint:php": "composer lint",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "seed": "wp-env run cli wp keystone seed",
    "export:static": "bash bin/export-static.sh",
    "vendor": "node bin/copy-vendor.js",
    "build:assets": "node bin/build-assets.js",
    "build:blocks": "wp-scripts build --webpack-src-dir=themes/keystone/src/blocks --output-path=themes/keystone/build/blocks --webpack-copy-php",
    "lint": "npm run lint:php && npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/scripts": "^30.0.0",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  }
}
